---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | prepend: site.url }}" rel="self"/>
  <link href="{{ '/' | prepend: site.url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | prepend: site.url }}</id>
  <author>
    <name>{{ site.author | xml_escape }}</name>
  </author>
  {%- for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | prepend: site.url }}"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | prepend: site.url }}</id>
    {%- assign dek = post.dek | default: post.excerpt_override | default: post.excerpt %}
    <summary>{{ dek | strip_html | normalize_whitespace | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
